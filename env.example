# ============================================================================
# OLm-Mn-wed environment variables
# Copy to `.env` and adjust as needed:  cp .env.example .env
# ============================================================================

# Host port for the Web UI (container-internal port stays 3000)
WEB_PORT=3000

# Host port for the OpenAI-compatible API (container-internal port stays 3001)
API_PORT=3001

# JWT signing secret. Leave empty to auto-generate and persist
# to ./data/.secret_key (survives restarts).
SECRET_KEY=

# How long Ollama keeps a model loaded in memory (e.g. 5m, 30m, -1 = forever)
OLLAMA_KEEP_ALIVE=5m

# GitHub repo used by "Check for updates" for this project,
# e.g. someone/olm-mn-wed. Leave empty to skip the project version check.
PROJECT_REPO=

# Container timezone
TZ=UTC
